generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  PRACTITIONER
  SECRETARY
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SessionType {
  PSYCHOTHERAPY // priced per session (patient rate)
  ADMIN // administrative work, priced per hour
  WRITING // report writing, priced per hour
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

// ---------------------------------------------------------------------------
// Workspace (Tenant)
// ---------------------------------------------------------------------------

model Workspace {
  id   String @id // Clerk user ID: user_xxxxx (one workspace per practitioner)
  name String
  slug String @unique

  // Billing defaults – practitioners can override per appointment
  defaultTariff Decimal @default(0) @db.Decimal(10, 2)
  taxRate       Decimal @default(0) @db.Decimal(5, 2)
  currency      String  @default("EUR")

  // Hourly rates for non-therapy work (time filled per half hour)
  hourlyRateAdmin   Decimal @default(0) @db.Decimal(10, 2)
  hourlyRateWriting Decimal @default(0) @db.Decimal(10, 2)

  // Cancellations: notice period shown when cancelling (the practitioner decides
  // whether a fee applies) and the per-patient alert threshold over 30 days
  cancellationNoticeHours    Int @default(48)
  cancellationAlertThreshold Int @default(3)

  // Data retention reminders: inactive patients, and patients in Recently deleted
  retentionYears Int @default(5)

  // Availability settings
  workingDays       Int[] // 1=Mon … 7=Sun (ISO weekday)
  workingHoursStart String @default("09:00") // "HH:mm"
  workingHoursEnd   String @default("18:00") // "HH:mm"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        WorkspaceMember[]
  patients       Patient[]
  appointments   Appointment[]
  invoices       Invoice[]
  documents      Document[]
  patientUsers   PatientUser[]
  patientInvites PatientInvite[]
  rateChanges    PatientRateChange[]
}

// ---------------------------------------------------------------------------
// User & Workspace membership
// ---------------------------------------------------------------------------

model User {
  id    String @id // Clerk user ID: user_xxxxx
  email String @unique
  name  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces        WorkspaceMember[]
  appointments      Appointment[]     @relation("PractitionerAppointments")
  uploadedDocuments Document[]        @relation("UploadedDocuments")
}

// Join table that stores the role of a User within a specific Workspace.
// A user could theoretically be a practitioner in one clinic and a secretary
// in another – this model handles that cleanly.
model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        UserRole @default(PRACTITIONER)
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Patient
// ---------------------------------------------------------------------------

model Patient {
  id          String    @id @default(cuid())
  workspaceId String
  firstName   String
  lastName    String
  email       String?
  phone       String? // normalised international format, e.g. "+33 6 12 34 56 78"
  dateOfBirth DateTime? @db.Date
  gender      String? // "FEMALE" | "MALE" | "OTHER"
  pronouns    String?

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  doctorName               String? // family doctor
  doctorPhone              String?

  // Individual psychotherapy rate; null = practice default. Scheduled changes in PatientRateChange.
  tariff Decimal? @db.Decimal(10, 2)

  // General (non-session) notes visible to practitioners
  backgroundNotes String?

  // Soft delete: set when the practitioner deletes the patient. The record moves to
  // "Recently deleted" (history and invoices kept) until restored or permanently deleted.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  invoices     Invoice[]
  documents    Document[]
  portalUser   PatientUser?
  invites      PatientInvite[]
  rateChanges  PatientRateChange[]

  @@index([workspaceId])
  @@index([workspaceId, lastName])
  @@index([workspaceId, deletedAt])
}

// ---------------------------------------------------------------------------
// Appointment
// ---------------------------------------------------------------------------

model Appointment {
  id             String            @id @default(cuid())
  workspaceId    String
  patientId      String
  practitionerId String
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(SCHEDULED)
  type           SessionType       @default(PSYCHOTHERAPY)

  // Cancellation: when, and the fee charged (null = no fee). The practitioner
  // decides whether a cancellation is late; charging a fee is the default.
  cancelledAt     DateTime?
  cancellationFee Decimal?  @db.Decimal(10, 2)

  // Session note written after the appointment (practitioners only)
  sessionNotes    String?
  noteCompletedAt DateTime?

  // Price snapshot at booking: the session price for psychotherapy, or
  // hourlyRate × duration for hourly work (recomputed when the time changes)
  tariffAmount Decimal  @db.Decimal(10, 2)
  hourlyRate   Decimal? @db.Decimal(10, 2)
  taxRate      Decimal  @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient      Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner User       @relation("PractitionerAppointments", fields: [practitionerId], references: [id])
  invoice      Invoice?
  documents    Document[]

  @@index([workspaceId])
  @@index([workspaceId, startTime])
  @@index([patientId])
  @@index([practitionerId])
}

// ---------------------------------------------------------------------------
// Document
// ---------------------------------------------------------------------------

model Document {
  id            String  @id @default(cuid())
  workspaceId   String
  patientId     String
  appointmentId String?
  uploadedById  String

  name     String
  fileKey  String // GCS object key (used for signed URLs + deletion)
  fileType String // MIME type
  fileSize Int // bytes

  sharedWithPatient Boolean @default(false)
  // Uploaded instead of typed session notes: never shared with the patient
  isSessionNote     Boolean @default(false)

  createdAt DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  uploadedBy  User         @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  @@index([workspaceId])
  @@index([patientId])
  @@index([appointmentId])
}

// ---------------------------------------------------------------------------
// Patient portal
// ---------------------------------------------------------------------------

model PatientUser {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  patientId   String   @unique
  workspaceId String
  createdAt   DateTime @default(now())

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model PatientInvite {
  id          String    @id @default(cuid())
  workspaceId String
  patientId   String
  token       String    @unique @default(uuid())
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// AuditLog
// ---------------------------------------------------------------------------

model AuditLog {
  id           String @id @default(cuid())
  workspaceId  String
  userId       String // Clerk user ID
  action       String // e.g. "VIEW_PATIENT_NOTES", "EDIT_SESSION_NOTES"
  resourceType String // "Patient" | "Appointment" | "Document"
  resourceId   String
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Invoice
// ---------------------------------------------------------------------------

model Invoice {
  id            String  @id @default(cuid())
  workspaceId   String
  patientId     String
  appointmentId String? @unique // one-to-one with Appointment

  invoiceNumber String // sequential per workspace and year: INV-2026-0001
  amount        Decimal @db.Decimal(10, 2)
  taxAmount     Decimal @db.Decimal(10, 2)
  taxRate       Decimal @db.Decimal(5, 2)
  totalAmount   Decimal @db.Decimal(10, 2)
  notes         String?
  publicToken   String  @unique @default(uuid())

  status  InvoiceStatus @default(DRAFT)
  dueDate DateTime

  paidAt         DateTime?
  receiptSentAt  DateTime? // last time the receipt (quittance) was emailed
  reminderSentAt DateTime? // last dunning reminder timestamp

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([patientId])
}

// A patient's psychotherapy rate from a given date, with a reminder until the
// practitioner has told the patient. Sessions already booked keep their price.
model PatientRateChange {
  id             String    @id @default(cuid())
  workspaceId    String
  patientId      String
  amount         Decimal   @db.Decimal(10, 2)
  previousAmount Decimal   @db.Decimal(10, 2)
  effectiveFrom  DateTime  @db.Date
  notifiedAt     DateTime? // practitioner marked the patient as informed
  createdAt      DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, notifiedAt])
  @@index([patientId, effectiveFrom])
}
