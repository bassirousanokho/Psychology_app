generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  PRACTITIONER
  SECRETARY
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SessionType {
  PSYCHOTHERAPY // priced per session (patient rate)
  ADMIN // administrative work, priced per hour
  WRITING // report writing, priced per hour
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED // replaced by a credit note (or a draft withdrawn before it was sent)
}

enum InvoiceKind {
  INVOICE
  CREDIT_NOTE // cancels an invoice; amounts are negative
}

// ---------------------------------------------------------------------------
// Workspace (Tenant)
// ---------------------------------------------------------------------------

model Workspace {
  id   String @id // Clerk user ID: user_xxxxx (one workspace per practitioner)
  name String
  slug String @unique

  // Billing defaults – practitioners can override per appointment
  defaultTariff Decimal @default(0) @db.Decimal(10, 2)
  taxRate       Decimal @default(0) @db.Decimal(6, 3) // combined rate applied at booking
  currency      String  @default("CAD")

  // Québec: GST (TPS) and QST (TVQ) shown as separate lines; taxRate = gstRate + qstRate.
  // Psychotherapy is exempt, so these stay 0 unless the practice bills taxable services.
  gstRate Decimal @default(0) @db.Decimal(6, 3)
  qstRate Decimal @default(0) @db.Decimal(6, 3)

  // Drives currency default, phone format, legal fields and invoice wording (src/lib/regions.ts)
  region String @default("CA-QC") // "CA-QC" | "FR"

  // Interface and email language for the practice and its patients
  language String @default("fr") // "fr" | "en"

  // Day-before session reminder emails to patients
  sessionRemindersEnabled Boolean @default(true)

  // Hourly rates for non-therapy work (time filled per half hour)
  hourlyRateAdmin   Decimal @default(0) @db.Decimal(10, 2)
  hourlyRateWriting Decimal @default(0) @db.Decimal(10, 2)

  // Cancellations: notice period shown when cancelling (the practitioner decides
  // whether a fee applies) and the per-patient alert threshold over 30 days
  cancellationNoticeHours    Int @default(48)
  cancellationAlertThreshold Int @default(3)

  // Data retention reminders: inactive patients, and patients in Recently deleted
  retentionYears Int @default(5)

  // Patients may cancel or move their own sessions from the portal. Within the
  // cancellation notice period the session price is charged as a fee by default.
  patientSelfServiceEnabled Boolean @default(true)

  // Legal mentions printed on invoices and receipts (French "note d'honoraires")
  practitionerName  String? // as printed; defaults to the workspace name
  professionalTitle String? @default("Psychologue")
  address           String? // multi-line
  // Québec
  permitNumber      String? // OPQ permit number
  neq               String? // Québec enterprise number
  gstNumber         String? // TPS, if registered
  qstNumber         String? // TVQ, if registered
  // France
  siret             String?
  adeli             String?
  rpps              String?
  vatMention        String? @default("Services de psychothérapie exonérés de TPS et de TVQ.") // tax mention
  paymentTerms      String? @default("Paiement exigible le jour de la séance.")
  invoiceNotes      String? // any extra mention

  // Optional images (GCS object keys) printed at the top / bottom of invoices
  invoiceHeaderKey String?
  invoiceFooterKey String?

  // Availability settings
  workingDays       Int[] // 1=Mon … 7=Sun (ISO weekday)
  workingHoursStart String @default("09:00") // "HH:mm"
  workingHoursEnd   String @default("18:00") // "HH:mm"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        WorkspaceMember[]
  patients       Patient[]
  appointments   Appointment[]
  invoices       Invoice[]
  documents      Document[]
  patientUsers   PatientUser[]
  patientInvites PatientInvite[]
  rateChanges    PatientRateChange[]
  messages       Message[]
  statements     Statement[]
  noteTemplates  NoteTemplate[]
  formTemplates  FormTemplate[]
  formRequests   FormRequest[]
}

// ---------------------------------------------------------------------------
// User & Workspace membership
// ---------------------------------------------------------------------------

model User {
  id    String @id // Clerk user ID: user_xxxxx
  email String @unique
  name  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspaces        WorkspaceMember[]
  appointments      Appointment[]     @relation("PractitionerAppointments")
  uploadedDocuments Document[]        @relation("UploadedDocuments")
}

// Join table that stores the role of a User within a specific Workspace.
// A user could theoretically be a practitioner in one clinic and a secretary
// in another – this model handles that cleanly.
model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        UserRole @default(PRACTITIONER)
  joinedAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Patient
// ---------------------------------------------------------------------------

model Patient {
  id          String    @id @default(cuid())
  workspaceId String
  firstName   String
  lastName    String
  email       String?
  phone       String? // normalised international format, e.g. "+33 6 12 34 56 78"
  dateOfBirth DateTime? @db.Date
  gender      String? // "FEMALE" | "MALE" | "OTHER"
  pronouns    String?
  address     String? // printed on invoices ("Facturé à")

  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  doctorName               String? // family doctor
  doctorPhone              String?

  // Individual psychotherapy rate; null = practice default. Scheduled changes in PatientRateChange.
  tariff Decimal? @db.Decimal(10, 2)

  // General (non-session) notes visible to practitioners
  backgroundNotes String?

  // Day-before session reminder emails (practice setting must also be on)
  remindersEnabled Boolean @default(true)

  // Soft delete: set when the practitioner deletes the patient. The record moves to
  // "Recently deleted" (history and invoices kept) until restored or permanently deleted.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  invoices     Invoice[]
  documents    Document[]
  portalUser   PatientUser?
  invites      PatientInvite[]
  rateChanges  PatientRateChange[]
  messages     Message[]
  statements   Statement[]
  formRequests FormRequest[]

  @@index([workspaceId])
  @@index([workspaceId, lastName])
  @@index([workspaceId, deletedAt])
}

// ---------------------------------------------------------------------------
// Appointment
// ---------------------------------------------------------------------------

model Appointment {
  id             String            @id @default(cuid())
  workspaceId    String
  patientId      String
  practitionerId String
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(SCHEDULED)
  type           SessionType       @default(PSYCHOTHERAPY)

  // Cancellation: when, and the fee charged (null = no fee). The practitioner
  // decides whether a cancellation is late; charging a fee is the default.
  cancelledAt     DateTime?
  cancellationFee Decimal?  @db.Decimal(10, 2)

  // Session note written after the appointment (practitioners only)
  sessionNotes    String?
  noteCompletedAt DateTime?

  // Price snapshot at booking: the session price for psychotherapy, or
  // hourlyRate × duration for hourly work (recomputed when the time changes)
  tariffAmount Decimal  @db.Decimal(10, 2)
  hourlyRate   Decimal? @db.Decimal(10, 2)
  taxRate      Decimal  @db.Decimal(6, 3)

  // Recurring sessions booked together share a seriesId (weekly / every 2 weeks)
  seriesId String?

  // Day-before reminder email to the patient
  reminderSentAt DateTime?

  // Cancelled or moved by the patient from the portal
  changedByPatientAt DateTime?

  // The invoice billing this session (one invoice may bill several sessions).
  // Cleared when that invoice is cancelled, so the session can be billed again.
  invoiceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  practitioner User          @relation("PractitionerAppointments", fields: [practitionerId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceLines InvoiceLine[]
  documents    Document[]

  @@index([workspaceId])
  @@index([workspaceId, startTime])
  @@index([seriesId])
  @@index([patientId])
  @@index([practitionerId])
  @@index([invoiceId])
}

// ---------------------------------------------------------------------------
// Document
// ---------------------------------------------------------------------------

model Document {
  id            String  @id @default(cuid())
  workspaceId   String
  patientId     String
  appointmentId String?
  uploadedById  String

  name     String
  fileKey  String // GCS object key (used for signed URLs + deletion)
  fileType String // MIME type
  fileSize Int // bytes

  sharedWithPatient Boolean @default(false)
  // Uploaded instead of typed session notes: never shared with the patient
  isSessionNote     Boolean @default(false)

  createdAt DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  uploadedBy  User         @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  @@index([workspaceId])
  @@index([patientId])
  @@index([appointmentId])
}

// ---------------------------------------------------------------------------
// Patient portal
// ---------------------------------------------------------------------------

model PatientUser {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  patientId   String   @unique
  workspaceId String
  createdAt   DateTime @default(now())

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model PatientInvite {
  id          String    @id @default(cuid())
  workspaceId String
  patientId   String
  token       String    @unique @default(uuid())
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// AuditLog
// ---------------------------------------------------------------------------

model AuditLog {
  id           String @id @default(cuid())
  workspaceId  String
  userId       String // Clerk user ID
  action       String // e.g. "VIEW_PATIENT_NOTES", "EDIT_SESSION_NOTES"
  resourceType String // "Patient" | "Appointment" | "Document"
  resourceId   String
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
}

// ---------------------------------------------------------------------------
// Invoice
// ---------------------------------------------------------------------------

model Invoice {
  id          String      @id @default(cuid())
  workspaceId String
  patientId   String
  kind        InvoiceKind @default(INVOICE)

  invoiceNumber String // sequential per workspace and year: INV-2026-0001 (credit notes: NC-/AV-2026-0001)
  // Totals of the lines (negative on a credit note)
  amount        Decimal @db.Decimal(10, 2)
  taxAmount     Decimal @db.Decimal(10, 2)
  taxRate       Decimal @db.Decimal(6, 3) // rate of the lines when they share one, else 0
  // Separate tax lines when the region has several taxes (Québec: TPS + TVQ):
  // [{ label: "TPS", rate: 5, amount: 6.5 }, …]. Null = a single tax line.
  taxLines      Json?
  totalAmount   Decimal @db.Decimal(10, 2)
  notes         String?
  publicToken   String  @unique @default(uuid())

  status  InvoiceStatus @default(DRAFT)
  dueDate DateTime

  sentAt         DateTime? // emailed to the patient (status SENT)
  paidAt         DateTime? // credit note: the amount was refunded
  receiptSentAt  DateTime? // last time the receipt (quittance) was emailed
  reminderSentAt DateTime? // last dunning reminder timestamp

  // Cancellation (status CANCELLED). Sent or paid invoices are cancelled by a credit note.
  cancelledAt  DateTime?
  cancelReason String?
  // Credit note → the invoice it cancels
  creditedInvoiceId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace       Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  lines           InvoiceLine[]
  appointments    Appointment[]
  creditedInvoice Invoice?      @relation("CreditNote", fields: [creditedInvoiceId], references: [id])
  creditNote      Invoice?      @relation("CreditNote")

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([patientId])
}

// One line of an invoice: a session, a fee or any service, with an optional discount.
model InvoiceLine {
  id              String  @id @default(cuid())
  invoiceId       String
  appointmentId   String? // the session billed by this line, if any (kept after cancellation)
  position        Int
  description     String
  quantity        Decimal @default(1) @db.Decimal(10, 2) // hours for hourly work
  unitPrice       Decimal @db.Decimal(10, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxRate         Decimal @default(0) @db.Decimal(6, 3)
  amount          Decimal @db.Decimal(10, 2) // quantity × unit price − discount, before tax

  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([appointmentId])
}

// A patient's psychotherapy rate from a given date, with a reminder until the
// practitioner has told the patient. Sessions already booked keep their price.
model PatientRateChange {
  id             String    @id @default(cuid())
  workspaceId    String
  patientId      String
  amount         Decimal   @db.Decimal(10, 2)
  previousAmount Decimal   @db.Decimal(10, 2)
  effectiveFrom  DateTime  @db.Date
  notifiedAt     DateTime? // practitioner marked the patient as informed
  createdAt      DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, notifiedAt])
  @@index([patientId, effectiveFrom])
}

// Statement of payments for a patient over a period (e.g. a year, for insurance
// claims). Created when shared; the public page lists the paid invoices in range.
model Statement {
  id          String   @id @default(cuid())
  workspaceId String
  patientId   String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  publicToken String   @unique @default(uuid())
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

enum MessageStatus {
  SENT // handed to the email provider
  FAILED // the provider refused it
  NOT_CONFIGURED // no email provider set up: saved, not sent
}

// Emails written to a patient from the app. The body may contain clinical
// information, so it is stored encrypted (enc:… like session notes).
model Message {
  id          String        @id @default(cuid())
  workspaceId String
  patientId   String
  senderId    String // Clerk user id
  toEmail     String
  subject     String
  body        String // encrypted
  status      MessageStatus
  error       String?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Note templates
// ---------------------------------------------------------------------------

// Reusable text inserted into session notes (SOAP, DAP, intake assessment…)
model NoteTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ---------------------------------------------------------------------------
// Forms (intake, consent, questionnaires)
// ---------------------------------------------------------------------------

enum FormKind {
  INTAKE
  CONSENT
  QUESTIONNAIRE
}

enum FormRequestStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// A form the practice sends to patients. Fields: [{ id, type, label, … }] (src/lib/forms.ts)
model FormTemplate {
  id                String    @id @default(cuid())
  workspaceId       String
  name              String
  kind              FormKind
  description       String?
  fields            Json
  requiresSignature Boolean   @default(false)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requests  FormRequest[]

  @@index([workspaceId])
}

// A form sent to one patient: a copy of the template as sent, then the answers.
// Answers may hold clinical information, so they're stored encrypted (enc:…).
model FormRequest {
  id                String            @id @default(cuid())
  workspaceId       String
  patientId         String
  templateId        String?
  name              String
  kind              FormKind
  description       String?
  fields            Json
  requiresSignature Boolean
  token             String            @unique @default(uuid()) // link emailed to the patient
  status            FormRequestStatus @default(PENDING)
  answers           String? // encrypted JSON { fieldId: value }
  // Electronic signature: typed full name, with when and from where it was signed
  signatureName     String?
  signedAt          DateTime?
  signerIp          String?
  signerUserAgent   String?
  sentAt            DateTime?
  completedAt       DateTime?
  createdAt         DateTime          @default(now())

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  template  FormTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([patientId])
}
